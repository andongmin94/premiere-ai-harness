{
  "name": "premiere-ai-harness",
  "version": "0.4.0",
  "private": true,
  "description": "A local-first Premiere Pro UXP rough-cut harness",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "complexity": "node scripts/complexity.mjs",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=70 --test test/*.test.js",
    "package": "node scripts/package-plugin.mjs",
    "test:package": "node scripts/test-package.mjs",
    "verify": "npm run check && npm run complexity && npm run test:coverage && npm run package && npm run test:package"
  }
}
